# Maintainer: D3SOX <https://github.com/D3SOX>

pkgname=t3code-d3sox-git
_pkgname=t3code
pkgver=0.0.40.r4006.gae1f057
pkgrel=1
pkgdesc='T3 Code desktop app built from the latest D3SOX fork commit'
arch=('x86_64')
url='https://github.com/D3SOX/t3code'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
makedepends=(
  'git'
  'imagemagick'
  'libsecret'
  'nodejs'
  'pkgconf'
  'pnpm'
  'rust'
)
optdepends=('openai-codex: use the system-installed Codex CLI')
provides=("t3code=$pkgver")
conflicts=('t3code' 't3code-bin' 't3code-git' 't3code-nightly-bin')
options=('!debug' '!emptydirs' '!strip')
source=("$_pkgname::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"

  local version
  version=$(sed -n 's/.*"version": "\([^"]*\)".*/\1/p' apps/desktop/package.json | head -n 1)
  printf '%s.r%s.g%s' \
    "$version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$srcdir/$_pkgname"
  pnpm install --frozen-lockfile
}

build() {
  cd "$srcdir/$_pkgname"
  pnpm dist:desktop:linux

  local appimage
  appimage=$(find release -maxdepth 1 -name '*.AppImage' -print -quit)
  if [[ -z "$appimage" ]]; then
    echo 'The desktop build did not produce an AppImage payload.' >&2
    return 1
  fi

  chmod +x "$appimage"
  "$appimage" --appimage-extract >/dev/null
}

package() {
  cd "$srcdir/$_pkgname"

  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership squashfs-root/. "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/t3code" <<'EOF'
#!/bin/sh
exec /opt/t3code-d3sox-git/AppRun "$@"
EOF
  ln -s t3code "$pkgdir/usr/bin/t3-code-desktop"

  local icon size_dir
  for icon in squashfs-root/usr/share/icons/hicolor/*/apps/t3code.png; do
    size_dir="${icon%/apps/t3code.png}"
    install -Dm644 "$icon" \
      "$pkgdir/usr/share/icons/hicolor/${size_dir##*/}/apps/t3code.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/t3code.desktop" <<'EOF'
[Desktop Entry]
Name=T3 Code
Comment=Desktop control surface for local coding agents
Exec=t3code %U
TryExec=t3code
Terminal=false
Type=Application
Icon=t3code
StartupWMClass=t3code
Categories=Development;
MimeType=x-scheme-handler/t3code;
EOF

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
